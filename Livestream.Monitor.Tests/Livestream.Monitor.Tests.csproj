<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Livestream.Monitor.Direct2D\Livestream.Monitor.Direct2D.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" />
    <PackageReference Include="AutoFixture" Version="4.18.1" />
    <PackageReference Include="AutoFixture.AutoNSubstitute" Version="4.18.1" />
    <PackageReference Include="AutoFixture.Xunit2" Version="4.18.1" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <ProjectReference Include="..\Livestream.Monitor.WPF\Livestream.Monitor.WPF.csproj" />
    <None Update="*.local" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    UI tests launch Release builds of the frontends, as users run optimised builds; the other tests use this project's
    configuration. The executables' paths are listed in ui-apps.txt in the test output.
  -->
  <ItemGroup>
    <UiTestApp Include="..\Livestream.Monitor.WPF\Livestream.Monitor.WPF.csproj" />
    <UiTestApp Include="..\Livestream.Monitor.Direct2D\Livestream.Monitor.Direct2D.csproj" />
  </ItemGroup>
  <Target Name="BuildUiTestApps" AfterTargets="Build">
    <MSBuild Projects="@(UiTestApp)" Targets="Build" Properties="Configuration=Release">
      <Output TaskParameter="TargetOutputs" ItemName="UiTestAppAssembly" />
    </MSBuild>
    <WriteLinesToFile
      File="$(OutDir)ui-apps.txt"
      Lines="@(UiTestAppAssembly->'%(RootDir)%(Directory)%(Filename).exe')"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
