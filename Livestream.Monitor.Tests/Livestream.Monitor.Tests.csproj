<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="VSTestTestCaseFilter">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <UiTestProject>..\Livestream.Monitor.Direct2D\Livestream.Monitor.Direct2D.csproj</UiTestProject>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- Use -p:TestScope=All to include quality settings, or -p:TestScope=QualitySettings to run just that feature. -->
  <PropertyGroup Condition="'$(TestScope)' != 'All'">
    <_QualitySettingsFilter>Feature!=QualitySettings</_QualitySettingsFilter>
    <_QualitySettingsFilter Condition="'$(TestScope)' == 'QualitySettings'">Feature=QualitySettings</_QualitySettingsFilter>
    <VSTestTestCaseFilter Condition="'$(VSTestTestCaseFilter)' != ''">($(VSTestTestCaseFilter))&amp;$(_QualitySettingsFilter)</VSTestTestCaseFilter>
    <VSTestTestCaseFilter Condition="'$(VSTestTestCaseFilter)' == ''">$(_QualitySettingsFilter)</VSTestTestCaseFilter>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(UiTestProject)" />
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" />
    <PackageReference Include="AutoFixture" Version="4.18.1" />
    <PackageReference Include="AutoFixture.AutoNSubstitute" Version="4.18.1" />
    <PackageReference Include="AutoFixture.Xunit2" Version="4.18.1" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <None Update="*.local" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- UI tests launch the Release executable from any build configuration. -->
  <Target Name="BuildUiTestApp" AfterTargets="Build">
    <MSBuild Projects="$(UiTestProject)" Targets="Build" Properties="Configuration=Release">
      <Output TaskParameter="TargetOutputs" ItemName="UiTestAppAssembly" />
    </MSBuild>
    <WriteLinesToFile
      File="$(OutDir)ui-app.txt"
      Lines="@(UiTestAppAssembly->'%(RootDir)%(Directory)%(Filename).exe')"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
