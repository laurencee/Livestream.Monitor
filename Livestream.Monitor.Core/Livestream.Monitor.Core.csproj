<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Folders mirror the existing Livestream.Monitor.Core.* and Livestream.Monitor.Model.* namespaces. -->
    <RootNamespace>Livestream.Monitor</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ExternalAPIs\ExternalAPIs.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Read through EmbeddedImages by these logical names. The language mapping is part of the generated atlas index. -->
    <EmbeddedResource Include="Images\*.png;Images\*.ico" LogicalName="Images.%(Filename)%(Extension)" />
    <!-- Guernsey has its own color profile and DPI. Other flag sources are packed into the atlas. -->
    <EmbeddedResource Include="Images\CountryFlags\gg.png" LogicalName="Images.CountryFlags.gg.png" />
  </ItemGroup>
</Project>
