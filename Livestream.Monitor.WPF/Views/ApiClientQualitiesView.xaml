<UserControl x:Class="Livestream.Monitor.WPF.Views.ApiClientQualitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:vm="clr-namespace:Livestream.Monitor.WPF.ViewModels"
             xmlns:cal="http://www.caliburnproject.org">
    <StackPanel>
        <TextBlock Text="Preferred qualities" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Text="Qualities are tried from top to bottom." TextWrapping="Wrap" Margin="0,0,0,6" />
        <TextBlock Text="{Binding EmptyQualityHint}" Margin="0,0,0,6">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource MahApps.Styles.TextBlock}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasQualities}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding QualityRows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:QualityPriorityRow}">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Priority}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="↑" MinWidth="26" Margin="2,0" ToolTip="Move up"
                                AutomationProperties.AutomationId="{Binding Priority, StringFormat=settings.quality.up.{0}}"
                                AutomationProperties.Name="Move up" cal:Message.Attach="MoveQualityUp($dataContext)" />
                        <Button Grid.Column="3" Content="↓" MinWidth="26" Margin="2,0" ToolTip="Move down"
                                AutomationProperties.AutomationId="{Binding Priority, StringFormat=settings.quality.down.{0}}"
                                AutomationProperties.Name="Move down" cal:Message.Attach="MoveQualityDown($dataContext)" />
                        <Button Grid.Column="4" Content="×" MinWidth="26" Margin="2,0" ToolTip="Remove quality"
                                AutomationProperties.AutomationId="{Binding Priority, StringFormat=settings.quality.remove.{0}}"
                                AutomationProperties.Name="{Binding Value, StringFormat=Remove {0}}" cal:Message.Attach="RemoveQuality($dataContext)" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid Margin="0,8,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewQuality" Margin="0,0,6,0" AutomationProperties.Name="New quality"
                     controls:TextBoxHelper.Watermark="Quality name, e.g. 480p"
                     cal:Message.Attach="[KeyDown] = [KeyPressed($eventArgs)]" />
            <Button Grid.Column="1" x:Name="AddQuality" Content="Add" />
        </Grid>
        <TextBlock Text="Fallback quality" FontWeight="SemiBold" Margin="0,0,0,6" />
        <StackPanel Orientation="Horizontal">
            <RadioButton Content="Best" IsChecked="{Binding FallbackQualityBestChecked}" Margin="0,0,18,0"
                         AutomationProperties.AutomationId="settings.quality.best" />
            <RadioButton Content="Worst" IsChecked="{Binding FallbackQualityWorstChecked}"
                         AutomationProperties.AutomationId="settings.quality.worst" />
        </StackPanel>
    </StackPanel>
</UserControl>
