<UserControl x:Class="Livestream.Monitor.WPF.Views.ApiClientsQualitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cal="http://www.caliburnproject.org">
    <StackPanel Margin="0,5,0,0">
        <TextBlock Text="Platform" Margin="0,0,0,5" />
        <ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedPlatform}"
                  DisplayMemberPath="DisplayName" AutomationProperties.Name="Quality platform"
                  AutomationProperties.AutomationId="settings.quality.platform" />
        <TextBlock Text="Custom preferences here replace 'All'." Foreground="IndianRed" TextWrapping="Wrap" Margin="0,6,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource MahApps.Styles.TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowOverrideNote}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <ContentControl cal:View.Model="{Binding SelectedPlatform}" Margin="0,10,0,0" />
    </StackPanel>
</UserControl>
